<assembly>
  <id>monitor-kafka-plugin</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <directory>target</directory>
      <outputDirectory></outputDirectory>
      <includes>
        <include>${artifactId}-${project.version}.jar</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>target/dependency</directory>
      <outputDirectory></outputDirectory>
      <includes>
        <include>gs-monitor-kafka-*.jar</include>
        <include>kafka-clients-*.jar</include>
        <include>kafka-avro-serializer-*.jar</include>
        <include>avro-*.jar</include>
        <include>kafka-schema-serializer-*.jar</include>
        <include>kafka-schema-registry-client-*.jar</include>
        <include>kafka-avro-types-*.jar</include>
        <include>kafka-schema-types-*.jar</include>
        <include>snappy-java-*.jar</include>
        <include>zstd-jni-*.jar</include>
        <include>lz4-java-*.jar</include>
        <include>common-utils-*.jar</include>
        <include>logredactor-*.jar</include>
        <include>minimal-json-*.jar</include>
        <include>commons-compress-*.jar</include>
        <include>snakeyaml-*.jar</include>
        <!-- GeoServer 3 ships Jackson 3 (tools.jackson), avro and the confluent serializers need Jackson 2 -->
        <include>jackson-core-2.*.jar</include>
        <include>jackson-databind-2.*.jar</include>
        <include>jackson-datatype-jdk8-2.*.jar</include>
        <include>jackson-dataformat-csv-2.*.jar</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
