<?xml version="1.0"?>
<assembly>
  <id>geofence-server-plugin</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <directory>target</directory>
      <outputDirectory/>
      <includes>
        <include>*.jar</include>
      </includes>
      <excludes>
        <exclude>*-sources.jar</exclude>
        <exclude>*-javadoc.jar</exclude>
        <exclude>*-tests.jar</exclude>
        <exclude>*-test-sources.jar</exclude>
      </excludes>
    </fileSet>
    <fileSet>
      <directory>target/dependency</directory>
      <outputDirectory/>
      <!-- jars genuinely new vs a base GeoServer install, per `dependency:list` diffed against gs-web-app -->
      <excludes>
        <exclude>*-tests.jar</exclude>
      </excludes>
      <includes>
        <include>gs-geofence-*.jar</include>
        <include>geofence-model-*.jar</include>
        <include>geofence-persistence-*.jar</include>
        <include>geofence-services-api-*.jar</include>
        <include>geofence-admin-services-api-*.jar</include>
        <include>geofence-services-impl-*.jar</include>
        <include>hibernate-core-*.jar</include>
        <include>hibernate-jcache-*.jar</include>
        <include>hibernate-spatial-*.jar</include>
        <include>hibernate-ant-*.jar</include>
        <include>hibernate-reveng-*.jar</include>
        <include>hibernate-models-*.jar</include>
        <include>jboss-logging-*.jar</include>
        <include>byte-buddy-*.jar</include>
        <include>jakarta.persistence-api-*.jar</include>
        <include>jakarta.transaction-api-*.jar</include>
        <include>geolatte-geom-*.jar</include>
        <include>postgis-jdbc-*.jar</include>
        <include>HikariCP-*.jar</include>
        <include>cache-api-*.jar</include>
        <include>ehcache-*.jar</include>
        <!-- needs the 4.13.x ATN format; base install ships an older 4.7.1 via Jiffle, see README -->
        <include>antlr4-runtime-*.jar</include>
        <include>jaxb-core-*.jar</include>
        <include>jaxb-runtime-*.jar</include>
        <include>txw2-*.jar</include>
        <include>istack-commons-runtime-*.jar</include>
        <!-- classic Jackson 2.x, coexists with GeoServer's own tools.jackson 3.x under a different package -->
        <include>jackson-core-2*.jar</include>
        <include>jackson-databind-2*.jar</include>
        <include>commons-lang-2*.jar</include>
        <include>dom4j-*.jar</include>
        <!-- "-5*" not a bare "jna-*": avoids also duplicating the base install's jna-jpms variant -->
        <include>jna-5*.jar</include>
        <include>jna-platform-5*.jar</include>
        <include>ecj-*.jar</include>
        <include>org.eclipse.jdt.core-*.jar</include>
        <include>org.eclipse.core.*.jar</include>
        <include>org.eclipse.equinox.*.jar</include>
        <include>org.eclipse.osgi-*.jar</include>
        <include>org.eclipse.text-*.jar</include>
        <include>osgi.annotation-*.jar</include>
        <include>org.osgi.service.prefs-*.jar</include>
        <include>spring-orm-*.jar</include>
        <include>spring-oxm-*.jar</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${geoserverBaseDir}/release/target/html/licenses</directory>
      <outputDirectory>licenses</outputDirectory>
      <includes>
        <include>GPL.html</include>
        <include>NOTICE.html</include>
      </includes>
    </fileSet>
  </fileSets>
  <files>
    <file>
      <!-- Same filename as the antlr4-runtime jar pulled in by the base install's Jiffle support, but
           empty (no classes) - overwrites it on plain extraction into WEB-INF/lib, so the incompatible
           old jar can never coexist with antlr4-runtime-4.13.2.jar even with no manual step. See README. -->
      <source>src/assembly/stub-jars/antlr4-runtime-4.7.1.jar</source>
      <outputDirectory/>
    </file>
    <file>
      <source>src/assembly/geofence-server-README.md</source>
      <outputDirectory/>
    </file>
    <file>
      <source>src/assembly/geofence-server-README.md</source>
      <outputDirectory/>
      <destName>README.txt</destName>
    </file>
    <file>
      <source>${geoserverBaseDir}/release/target/html/extensions/LICENSE.html</source>
      <outputDirectory/>
      <destName>LICENSE.html</destName>
    </file>
    <file>
      <source>target/html/geofence-server-README.html</source>
      <outputDirectory/>
      <destName>README.html</destName>
    </file>
  </files>
</assembly>
