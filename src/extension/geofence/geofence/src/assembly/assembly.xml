<?xml version="1.0"?>
<assembly>
  <id>geofence-plugin</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <directory>target</directory>
      <outputDirectory/>
      <includes>
        <include>*.jar</include>
      </includes>
      <excludes>
        <exclude>*-sources.jar</exclude>
        <exclude>*-javadoc.jar</exclude>
        <exclude>*-tests.jar</exclude>
        <exclude>*-test-sources.jar</exclude>
      </excludes>
    </fileSet>
    <fileSet>
      <directory>target/dependency</directory>
      <outputDirectory/>
      <!-- geofence-services-api has no third-party deps beyond what the base install already provides,
           but geofence-rest-client (the REST fallback RuleReaderService) brings its own Jersey client
           stack and a classic Jackson 2.x, per `dependency:list` diffed against gs-web-app -->
      <includes>
        <include>geofence-services-api-*.jar</include>
        <include>geofence-rest-api-*.jar</include>
        <include>geofence-rest-client-*.jar</include>
        <include>jersey-client-*.jar</include>
        <include>jersey-common-*.jar</include>
        <include>jersey-entity-filtering-*.jar</include>
        <include>jersey-media-json-jackson-*.jar</include>
        <include>jersey-media-multipart-*.jar</include>
        <include>jersey-proxy-client-*.jar</include>
        <include>jakarta.ws.rs-api-*.jar</include>
        <include>mimepull-*.jar</include>
        <include>osgi-resource-locator-*.jar</include>
        <!-- classic Jackson 2.x, coexists with GeoServer's own tools.jackson 3.x under a different package -->
        <include>jackson-core-2*.jar</include>
        <include>jackson-databind-2*.jar</include>
        <include>jackson-module-jakarta-xmlbind-annotations-2*.jar</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${geoserverBaseDir}/release/target/html/licenses</directory>
      <outputDirectory>licenses</outputDirectory>
      <includes>
        <include>GPL.html</include>
        <include>NOTICE.html</include>
      </includes>
    </fileSet>
  </fileSets>
  <files>
    <file>
      <source>${geoserverBaseDir}/release/extensions/README.md</source>
      <outputDirectory/>
      <destName>README.txt</destName>
    </file>
    <file>
      <source>${geoserverBaseDir}/release/target/html/extensions/LICENSE_GS.html</source>
      <outputDirectory/>
      <destName>LICENSE.html</destName>
    </file>
    <file>
      <source>${geoserverBaseDir}/release/target/html/extensions/README.html</source>
      <outputDirectory/>
      <destName>README.html</destName>
    </file>
  </files>
</assembly>
