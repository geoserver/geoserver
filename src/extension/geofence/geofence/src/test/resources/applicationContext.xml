<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context"
	xmlns:aop="http://www.springframework.org/schema/aop"
	xsi:schemaLocation="
	    	http://www.springframework.org/schema/beans   http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
			http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-2.5.xsd
			http://www.springframework.org/schema/aop     http://www.springframework.org/schema/aop/spring-aop-2.5.xsd"
	default-autowire="byName">

	<bean id="securityCategory" class="org.geoserver.web.Category">
        <property name="nameKey" value="category.security" />
        <property name="order" value="200" />
    </bean>

    <!-- Overrides the component-scanned restRuleReaderService bean with one pointing at a fixed, well-known URL -
         a literal property value, no placeholder resolution involved, so it isn't affected by where/when
         GeoFenceSpringConfig's own data-directory-relative properties file would otherwise be read from.
         Tests need a specific set of rules, so this points at a dedicated geofence test instance
         (see web/rest/test in geofence_39) that's expected to be running on this same port. -->
    <bean id="restRuleReaderService" class="org.geoserver.geofence.services.RestRuleReaderService">
        <property name="serviceUrl" value="http://localhost:9191/geofence/rest"/>
    </bean>
</beans>
